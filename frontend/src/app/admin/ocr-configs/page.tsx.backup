'use client';

import { useEffect, useMemo, useState, useCallback } from 'react';
import { useRouter, useSearchParams } from 'next/navigation';
import type {
  Company,
  DocumentType,
  CompanyDocTypeConfig,
} from '@/lib/api';
import { companiesApi, documentTypesApi, ocrConfigsApi } from '@/lib/api';
import { useOcrConfigQueryParams } from '@/hooks/useOcrConfigQueryParams';
import SmartDeleteDialog from '@/components/ui/SmartDeleteDialog';
import Pagination from '@/components/ui/Pagination';

const ITEM_TYPE_OPTIONS: Array<{ value: MappingItemType; label: string }> = [
  { value: 'single_source', label: 'Single Source' },
  { value: 'multi_source', label: 'Multi Source' },
];

const deriveFileNameFromPath = (path?: string) => {
  if (!path) return '';
  const segments = path.split('/');
  return segments[segments.length - 1] || '';
};

type FormMode = 'create' | 'edit';

type OutputMetaRow = {
  dest: string;
  srcType: 'ctx' | 'col';
  srcKey: string;
};

type AttachmentRule = {
  path?: string;
  filename_contains?: string;
  join_key?: string;
  label?: string;
  metadata?: string;
};

type CompanyGroup = {
  company_id: number;
  company_name: string;
  doc_types: {
    doc_type_id: number;
    doc_type_name: string;
    configs: CompanyDocTypeConfig[];
  }[];
};

interface FormState {
  company_id: string;
  doc_type_id: string;
  item_type: MappingItemType;
  prompt_path: string;
  schema_path: string;
  master_csv_path: string;
  output_template_path: string;
  original_prompt_filename?: string;
  original_schema_filename?: string;
  priority: string;
  active: boolean;
  // Single-source mapping
  single_external_join_keys: string;
  single_column_aliases: string;
  single_normalize_strip_non_digits: boolean;
  single_normalize_zfill: string;
  single_output_meta_rows: OutputMetaRow[];
  single_merge_suffix: string;
  // Multi-source mapping - step1 (OCR -> month Excel)
  multi_step1_join_keys: string;
  multi_step1_column_aliases: string;
  multi_step1_normalize_strip_non_digits: boolean;
  multi_step1_normalize_zfill: string;
  multi_step1_merge_suffix: string;
  // Multi-source mapping - step2 (step1 -> master CSV)
  multi_step2_join_keys: string;
  multi_step2_column_aliases: string;
  multi_step2_normalize_strip_non_digits: boolean;
  multi_step2_normalize_zfill: string;
  multi_step2_output_meta_rows: OutputMetaRow[];
  multi_step2_merge_suffix: string;
  // Multi-source attachment & internal join
  multi_internal_join_key: string;
}

const defaultFormState: FormState = {
  company_id: '',
  doc_type_id: '',
  item_type: 'single_source',
  prompt_path: '',
  schema_path: '',
  master_csv_path: '',
  output_template_path: '',
  original_prompt_filename: '',
  original_schema_filename: '',
  priority: '100',
  active: true,
  single_external_join_keys: '',
  single_column_aliases: '',
  single_normalize_strip_non_digits: false,
  single_normalize_zfill: '',
  single_output_meta_rows: [],
  single_merge_suffix: '',
  multi_step1_join_keys: '',
  multi_step1_column_aliases: '',
  multi_step1_normalize_strip_non_digits: false,
  multi_step1_normalize_zfill: '',
  multi_step1_merge_suffix: '',
  multi_step2_join_keys: '',
  multi_step2_column_aliases: '',
  multi_step2_normalize_strip_non_digits: false,
  multi_step2_normalize_zfill: '',
  multi_step2_output_meta_rows: [],
  multi_step2_merge_suffix: '',
  multi_internal_join_key: '',
};

export default function OcrConfigsAdminPage() {
  const [configs, setConfigs] = useState<CompanyDocTypeConfig[]>([]);
  const [companies, setCompanies] = useState<Company[]>([]);
  const [docTypes, setDocTypes] = useState<DocumentType[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<string>('');

  const [mode, setMode] = useState<FormMode>('create');
  const [editingConfig, setEditingConfig] = useState<CompanyDocTypeConfig | null>(null);
  const [form, setForm] = useState<FormState>(defaultFormState);
  const [multiAttachmentRules, setMultiAttachmentRules] = useState<AttachmentRule[]>([]);
  const [attachmentModalIndex, setAttachmentModalIndex] = useState<number | null>(null);

  const [filters, setFilters] = useState<{ company_id: string; doc_type_id: string; active: string }>({
    company_id: '',
    doc_type_id: '',
    active: '',
  });

  const [isSubmitting, setIsSubmitting] = useState(false);
  const [csvPreview, setCsvPreview] = useState<{ headers: string[]; row_count: number } | null>(
    null,
  );
  const [isPreviewingCsv, setIsPreviewingCsv] = useState(false);
  const [deleteDialog, setDeleteDialog] = useState<{
    isOpen: boolean;
    entity: { type: 'config'; id: number; name: string } | null;
  }>({ isOpen: false, entity: null });

  const companyLookup = useMemo(() => {
    const map = new Map<number, Company>();
    companies.forEach((c) => map.set(c.company_id, c));
    return map;
  }, [companies]);

  const docTypeLookup = useMemo(() => {
    const map = new Map<number, DocumentType>();
    docTypes.forEach((d) => map.set(d.doc_type_id, d));
    return map;
  }, [docTypes]);

  const parseColumnAliases = (value: string): Record<string, string> => {
    if (!value.trim()) {
      return {};
    }
    const aliases: Record<string, string> = {};
    value
      .split(',')
      .map((token) => token.trim())
      .filter(Boolean)
      .forEach((token) => {
        const [left, right] = token.split(':').map((part) => part.trim());
        if (left && right) {
          aliases[left] = right;
        }
      });
    return aliases;
  };

  const loadData = async () => {
    setIsLoading(true);
    setError('');
    try {
      const [cfgs, comps, docs] = await Promise.all([
        ocrConfigsApi.getAll(),
        companiesApi.getAll(),
        documentTypesApi.getAll(),
      ]);
      setConfigs(cfgs);
      setCompanies(comps);
      setDocTypes(docs);
    } catch (err) {
      console.error(err);
      setError('Failed to load OCR configs');
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    loadData();
  }, []);

  const filteredConfigs = useMemo(() => {
    return configs.filter((cfg) => {
      if (filters.company_id && String(cfg.company_id) !== filters.company_id) return false;
      if (filters.doc_type_id && String(cfg.doc_type_id) !== filters.doc_type_id) return false;
      if (filters.active === 'true' && !cfg.active) return false;
      if (filters.active === 'false' && cfg.active) return false;
      return true;
    });
  }, [configs, filters]);

  const groupedConfigs = useMemo<CompanyGroup[]>(() => {
    const companyMap = new Map<
      number,
      {
        company_id: number;
        company_name: string;
        docTypes: Map<
          number,
          {
            doc_type_id: number;
            doc_type_name: string;
            configs: CompanyDocTypeConfig[];
          }
        >;
      }
    >();

    filteredConfigs.forEach((cfg) => {
      const companyId = cfg.company_id;
      let companyGroup = companyMap.get(companyId);
      if (!companyGroup) {
        const companyName =
          cfg.company_name ||
          companyLookup.get(companyId)?.company_name ||
          `ID ${companyId}`;
        companyGroup = {
          company_id: companyId,
          company_name: companyName,
          docTypes: new Map(),
        };
        companyMap.set(companyId, companyGroup);
      }

      const docTypeId = cfg.doc_type_id;
      let docTypeGroup = companyGroup.docTypes.get(docTypeId);
      if (!docTypeGroup) {
        const docTypeName =
          cfg.doc_type_name ||
          docTypeLookup.get(docTypeId)?.type_name ||
          `ID ${docTypeId}`;
        docTypeGroup = {
          doc_type_id: docTypeId,
          doc_type_name: docTypeName,
          configs: [],
        };
        companyGroup.docTypes.set(docTypeId, docTypeGroup);
      }

      docTypeGroup.configs.push(cfg);
    });

    return Array.from(companyMap.values()).map((company) => ({
      company_id: company.company_id,
      company_name: company.company_name,
      doc_types: Array.from(company.docTypes.values()),
    }));
  }, [filteredConfigs, companyLookup, docTypeLookup]);

  const updateEditingConfigLocal = useCallback(
    (updates: Partial<CompanyDocTypeConfig>) => {
      setEditingConfig((prev) => {
        if (!prev) return prev;
        const next = { ...prev, ...updates };
        setConfigs((cfgs) =>
          cfgs.map((cfg) => (cfg.config_id === prev.config_id ? { ...cfg, ...updates } : cfg)),
        );
        return next;
      });
    },
    [setConfigs],
  );

  const onFormChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
    const { name, value, type, checked } = e.target as HTMLInputElement;
    setForm((prev) => ({
      ...prev,
      [name]:
        type === 'checkbox'
          ? checked
          : name === 'company_id' || name === 'doc_type_id'
          ? value
          : name === 'priority'
          ? value
          : value,
    }));
  };

  const handleMasterCsvChange = (path: string) => {
    setForm((prev) => ({
      ...prev,
      master_csv_path: path,
    }));
    setCsvPreview(null);
  };

  const handlePreviewMasterCsv = async () => {
    const trimmedPath = form.master_csv_path.trim();
    if (!trimmedPath || isPreviewingCsv) {
      if (!trimmedPath) {
        setCsvPreview(null);
      }
      return;
    }
    setIsPreviewingCsv(true);
    setError('');
    try {
      const resp = await fetch(
        `/api/mapping/master-csv/preview?path=${encodeURIComponent(trimmedPath)}`,
      );
      if (!resp.ok) {
        const data = await resp.json().catch(() => ({}));
        throw new Error(data.detail || 'Failed to preview master CSV');
      }
      const data = await resp.json();
      setCsvPreview({
        headers: data.headers || [],
        row_count: data.row_count || 0,
      });
    } catch (err) {
      console.error(err);
      setCsvPreview(null);
      setError(err instanceof Error ? err.message : 'Failed to preview master CSV');
    } finally {
      setIsPreviewingCsv(false);
    }
  };

  const handlePromptUploadComplete = (path: string) => {
    const filename = path ? deriveFileNameFromPath(path) : '';
    setForm((prev) => ({
      ...prev,
      prompt_path: path,
      original_prompt_filename: filename,
    }));
    updateEditingConfigLocal({
      prompt_path: path || null,
      original_prompt_filename: path ? filename : null,
    });
  };

  const handleSchemaUploadComplete = (path: string) => {
    const filename = path ? deriveFileNameFromPath(path) : '';
    setForm((prev) => ({
      ...prev,
      schema_path: path,
      original_schema_filename: filename,
    }));
    updateEditingConfigLocal({
      schema_path: path || null,
      original_schema_filename: path ? filename : null,
    });
  };

  const handleOutputTemplateUploadComplete = (path: string) => {
    setForm((prev) => ({
      ...prev,
      output_template_path: path,
    }));
    updateEditingConfigLocal({
      output_template_path: path || null,
    });
  };

  const openAttachmentBrowser = (index: number) => {
    setAttachmentModalIndex(index);
  };

  const closeAttachmentBrowser = () => {
    setAttachmentModalIndex(null);
  };

  const handleAttachmentPathSelect = (path: string) => {
    if (attachmentModalIndex === null) return;
    setMultiAttachmentRules((prev) => {
      if (!prev[attachmentModalIndex]) return prev;
      const next = [...prev];
      next[attachmentModalIndex] = { ...next[attachmentModalIndex], path };
      return next;
    });
    closeAttachmentBrowser();
  };

  const renderUploadPlaceholder = (label: string) => (
    <div className="border border-dashed border-gray-300 rounded-lg p-4 bg-gray-50 h-full flex flex-col justify-center">
      <p className="text-sm font-semibold text-gray-700">{label}</p>
      <p className="text-xs text-gray-500">
        Create the config first to upload the {label.toLowerCase()}.
      </p>
    </div>
  );

  const resetForm = () => {
    setMode('create');
    setEditingConfig(null);
    setForm(defaultFormState);
    setMultiAttachmentRules([]);
    setCsvPreview(null);
    setAttachmentModalIndex(null);
  };

  const onEdit = (cfg: CompanyDocTypeConfig) => {
    setMode('edit');
    setEditingConfig(cfg);

    // Single-source mapping defaults
    const singleCfg = (cfg.single_source_config || {}) as Record<string, any>;
    const singleExternalJoinKeys = Array.isArray(singleCfg.external_join_keys)
      ? singleCfg.external_join_keys.join(', ')
      : '';
    const singleColumnAliases = singleCfg.column_aliases
      ? Object.entries(singleCfg.column_aliases)
          .map(([k, v]: any) => `${k}:${v}`)
          .join(', ')
      : '';
    const singleStrip = !!(singleCfg.join_normalize && singleCfg.join_normalize.strip_non_digits);
    let singleZfill = '';
    if (
      singleCfg.join_normalize &&
      typeof singleCfg.join_normalize.zfill !== 'undefined' &&
      typeof singleCfg.join_normalize.zfill === 'number'
    ) {
      singleZfill = String(singleCfg.join_normalize.zfill);
    }
    const singleOutputMetaRows: OutputMetaRow[] = [];
    if (singleCfg.output_meta && typeof singleCfg.output_meta === 'object') {
      Object.entries(singleCfg.output_meta).forEach(([dest, src]: any) => {
        if (
          typeof dest === 'string' &&
          typeof src === 'string' &&
          (src.startsWith('ctx:') || src.startsWith('col:'))
        ) {
          const [prefix, key] = src.split(':', 2);
          singleOutputMetaRows.push({
            dest,
            srcType: prefix as 'ctx' | 'col',
            srcKey: key || '',
          });
        }
      });
    }

    // Multi-source step1 & step2 mapping
    const step1Cfg = (cfg.multi_source_step1_config || {}) as Record<string, any>;
    const step2Cfg = (cfg.multi_source_step2_config || {}) as Record<string, any>;

    const multiStep1JoinKeys = Array.isArray(step1Cfg.join_keys)
      ? step1Cfg.join_keys.join(', ')
      : '';
    const multiStep1ColumnAliases = step1Cfg.column_aliases
      ? Object.entries(step1Cfg.column_aliases)
          .map(([k, v]: any) => `${k}:${v}`)
          .join(', ')
      : '';
    const multiStep1Strip =
      !!(step1Cfg.join_normalize && step1Cfg.join_normalize.strip_non_digits);
    let multiStep1Zfill = '';
    if (
      step1Cfg.join_normalize &&
      typeof step1Cfg.join_normalize.zfill !== 'undefined' &&
      typeof step1Cfg.join_normalize.zfill === 'number'
    ) {
      multiStep1Zfill = String(step1Cfg.join_normalize.zfill);
    }

    const multiStep2JoinKeys = Array.isArray(step2Cfg.join_keys)
      ? step2Cfg.join_keys.join(', ')
      : '';
    const multiStep2ColumnAliases = step2Cfg.column_aliases
      ? Object.entries(step2Cfg.column_aliases)
          .map(([k, v]: any) => `${k}:${v}`)
          .join(', ')
      : '';
    const multiStep2Strip =
      !!(step2Cfg.join_normalize && step2Cfg.join_normalize.strip_non_digits);
    let multiStep2Zfill = '';
    if (
      step2Cfg.join_normalize &&
      typeof step2Cfg.join_normalize.zfill !== 'undefined' &&
      typeof step2Cfg.join_normalize.zfill === 'number'
    ) {
      multiStep2Zfill = String(step2Cfg.join_normalize.zfill);
    }
    const multiStep2OutputMetaRows: OutputMetaRow[] = [];
    if (step2Cfg.output_meta && typeof step2Cfg.output_meta === 'object') {
      Object.entries(step2Cfg.output_meta).forEach(([dest, src]: any) => {
        if (
          typeof dest === 'string' &&
          typeof src === 'string' &&
          (src.startsWith('ctx:') || src.startsWith('col:'))
        ) {
          const [prefix, key] = src.split(':', 2);
          multiStep2OutputMetaRows.push({
            dest,
            srcType: prefix as 'ctx' | 'col',
            srcKey: key || '',
          });
        }
      });
    }

    // Attachment rules (multi-source)
    const rules: AttachmentRule[] = Array.isArray(cfg.attachment_sources)
      ? cfg.attachment_sources.map((r: any) => ({
          path: r?.path || '',
          filename_contains: r?.filename_contains || '',
          join_key: r?.join_key || '',
          label: r?.label || '',
          metadata: r?.metadata ? JSON.stringify(r.metadata) : '',
        }))
      : [];

    setMultiAttachmentRules(rules);
    setCsvPreview(null);

    setForm({
      company_id: String(cfg.company_id),
      doc_type_id: String(cfg.doc_type_id),
      item_type: cfg.item_type,
      prompt_path: cfg.prompt_path || '',
      schema_path: cfg.schema_path || '',
      master_csv_path: cfg.master_csv_path || '',
      output_template_path: cfg.output_template_path || '',
      original_prompt_filename: cfg.original_prompt_filename || '',
      original_schema_filename: cfg.original_schema_filename || '',
      priority: String(cfg.priority ?? 100),
      active: cfg.active,
      single_external_join_keys: singleExternalJoinKeys,
      single_column_aliases: singleColumnAliases,
      single_normalize_strip_non_digits: singleStrip,
      single_normalize_zfill: singleZfill,
      single_output_meta_rows: singleOutputMetaRows,
      single_merge_suffix: (singleCfg.merge_suffix || '') as string,
      multi_step1_join_keys: multiStep1JoinKeys,
      multi_step1_column_aliases: multiStep1ColumnAliases,
      multi_step1_normalize_strip_non_digits: multiStep1Strip,
      multi_step1_normalize_zfill: multiStep1Zfill,
      multi_step1_merge_suffix: (step1Cfg.merge_suffix || '') as string,
      multi_step2_join_keys: multiStep2JoinKeys,
      multi_step2_column_aliases: multiStep2ColumnAliases,
      multi_step2_normalize_strip_non_digits: multiStep2Strip,
      multi_step2_normalize_zfill: multiStep2Zfill,
      multi_step2_output_meta_rows: multiStep2OutputMetaRows,
      multi_step2_merge_suffix: (step2Cfg.merge_suffix || '') as string,
      multi_internal_join_key: cfg.internal_join_key || '',
    });
  };

  const onSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!form.company_id || !form.doc_type_id) {
      setError('Please select company and document type');
      return;
    }
    setIsSubmitting(true);
    setError('');
    try {
      const trimmedMasterCsv = form.master_csv_path.trim();

      // Build single-source mapping config payload
      const buildSingleSourceConfig = () => {
        const cfg: any = {};
        if (trimmedMasterCsv) {
          cfg.master_csv_path = trimmedMasterCsv;
        }
        const keys = form.single_external_join_keys
          .split(',')
          .map((k) => k.trim())
          .filter(Boolean);
        if (keys.length > 0) {
          cfg.external_join_keys = keys;
        }
        const aliases = parseColumnAliases(form.single_column_aliases);
        if (Object.keys(aliases).length > 0) {
          cfg.column_aliases = aliases;
        }
        const jn: any = {};
        if (form.single_normalize_strip_non_digits) {
          jn.strip_non_digits = true;
        }
        const zf = (form.single_normalize_zfill || '').trim();
        if (zf) {
          const val = parseInt(zf, 10);
          if (!Number.isNaN(val) && val >= 0) {
            jn.zfill = val;
          }
        }
        if (Object.keys(jn).length > 0) {
          cfg.join_normalize = jn;
        }
        const om: Record<string, string> = {};
        for (const row of form.single_output_meta_rows) {
          const dest = (row.dest || '').trim();
          const srcKey = (row.srcKey || '').trim();
          if (dest && srcKey && (row.srcType === 'ctx' || row.srcType === 'col')) {
            om[dest] = `${row.srcType}:${srcKey}`;
          }
        }
        if (Object.keys(om).length > 0) {
          cfg.output_meta = om;
        }
        const ms = (form.single_merge_suffix || '').trim();
        if (ms) {
          cfg.merge_suffix = ms;
        }
        return Object.keys(cfg).length > 0 ? cfg : null;
      };

      // Build multi-source step1 config
      const buildMultiStep1Config = () => {
        const cfg: any = {};
        const keys = form.multi_step1_join_keys
          .split(',')
          .map((k) => k.trim())
          .filter(Boolean);
        if (keys.length > 0) {
          cfg.join_keys = keys;
        }
        const aliases = parseColumnAliases(form.multi_step1_column_aliases);
        if (Object.keys(aliases).length > 0) {
          cfg.column_aliases = aliases;
        }
        const jn: any = {};
        if (form.multi_step1_normalize_strip_non_digits) {
          jn.strip_non_digits = true;
        }
        const zf = (form.multi_step1_normalize_zfill || '').trim();
        if (zf) {
          const val = parseInt(zf, 10);
          if (!Number.isNaN(val) && val >= 0) {
            jn.zfill = val;
          }
        }
        if (Object.keys(jn).length > 0) {
          cfg.join_normalize = jn;
        }
        const ms = (form.multi_step1_merge_suffix || '').trim();
        if (ms) {
          cfg.merge_suffix = ms;
        }
        return Object.keys(cfg).length > 0 ? cfg : null;
      };

      // Build multi-source step2 config
      const buildMultiStep2Config = () => {
        const cfg: any = {};
        const keys = form.multi_step2_join_keys
          .split(',')
          .map((k) => k.trim())
          .filter(Boolean);
        if (keys.length > 0) {
          cfg.join_keys = keys;
        }
        const aliases = parseColumnAliases(form.multi_step2_column_aliases);
        if (Object.keys(aliases).length > 0) {
          cfg.column_aliases = aliases;
        }
        const jn: any = {};
        if (form.multi_step2_normalize_strip_non_digits) {
          jn.strip_non_digits = true;
        }
        const zf = (form.multi_step2_normalize_zfill || '').trim();
        if (zf) {
          const val = parseInt(zf, 10);
          if (!Number.isNaN(val) && val >= 0) {
            jn.zfill = val;
          }
        }
        if (Object.keys(jn).length > 0) {
          cfg.join_normalize = jn;
        }
        const om: Record<string, string> = {};
        for (const row of form.multi_step2_output_meta_rows) {
          const dest = (row.dest || '').trim();
          const srcKey = (row.srcKey || '').trim();
          if (dest && srcKey && (row.srcType === 'ctx' || row.srcType === 'col')) {
            om[dest] = `${row.srcType}:${srcKey}`;
          }
        }
        if (Object.keys(om).length > 0) {
          cfg.output_meta = om;
        }
        const ms = (form.multi_step2_merge_suffix || '').trim();
        if (ms) {
          cfg.merge_suffix = ms;
        }
        return Object.keys(cfg).length > 0 ? cfg : null;
      };

      // Build attachment_sources for multi-source configs
      let attachmentValidationFailed = false;
      const buildAttachmentSources = () => {
        if (form.item_type !== 'multi_source') return [];

        for (const r of multiAttachmentRules) {
          const text = (r.metadata || '').trim();
          if (text.length > 0) {
            try {
              const parsed = JSON.parse(text);
              if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
                throw new Error('metadata must be a JSON object');
              }
            } catch (e) {
              setError(
                'Invalid metadata JSON in attachment rules. Please provide a valid JSON object.',
              );
              attachmentValidationFailed = true;
              return [];
            }
          }
        }

        const cleaned = multiAttachmentRules
          .filter(
            (r) =>
              ((r.join_key || '').trim().length > 0 ||
                (r.filename_contains || '').trim().length > 0 ||
                (r.path || '').trim().length > 0),
          )
          .map((r) => {
            const obj: any = {
              kind: 'onedrive',
              path: (r.path || '').trim(),
              join_key: r.join_key?.trim() || undefined,
              filename_contains: r.filename_contains?.trim() || undefined,
            };
            const label = (r.label || '').trim();
            if (label) obj.label = label;
            const metaText = (r.metadata || '').trim();
            if (metaText) {
              try {
                const parsed = JSON.parse(metaText);
                if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
                  obj.metadata = parsed;
              }
              // metadata parsing already validated above; keep best-effort
            } catch {
              }
            }
            return obj;
          })
          .filter((r) => r.path.length > 0);
        return cleaned;
      };

      const singleConfig =
        form.item_type === 'single_source' ? buildSingleSourceConfig() : null;
      const multiStep1Config =
        form.item_type === 'multi_source' ? buildMultiStep1Config() : null;
      const multiStep2Config =
        form.item_type === 'multi_source' ? buildMultiStep2Config() : null;
      const attachmentSources = buildAttachmentSources();
      if (attachmentValidationFailed) {
        // metadata validation failed
        setIsSubmitting(false);
        return;
      }

      const payloadBase = {
        company_id: Number(form.company_id),
        doc_type_id: Number(form.doc_type_id),
        item_type: form.item_type,
        prompt_path: form.prompt_path || null,
        schema_path: form.schema_path || null,
        master_csv_path: trimmedMasterCsv || null,
        output_template_path: form.output_template_path || null,
        storage_type: 'local' as const,
        storage_metadata: null,
        single_source_config: singleConfig,
        multi_source_step1_config: multiStep1Config,
        multi_source_step2_config: multiStep2Config,
        internal_join_key:
          form.item_type === 'multi_source'
            ? (form.multi_internal_join_key || '').trim() || null
            : null,
        attachment_sources:
          form.item_type === 'multi_source' && attachmentSources.length > 0
            ? attachmentSources
            : null,
        active: form.active,
        priority: parseInt(form.priority || '100', 10) || 100,
      };

      if (mode === 'create') {
        const created = await ocrConfigsApi.create(payloadBase);
        setConfigs((prev) => [...prev, created]);
      } else if (mode === 'edit' && editingConfig) {
        // Build update payload (do not allow changing company/doc_type/item_type)
        const updated = await ocrConfigsApi.update(editingConfig.config_id, {
          prompt_path: payloadBase.prompt_path,
          schema_path: payloadBase.schema_path,
          master_csv_path: payloadBase.master_csv_path,
          output_template_path: payloadBase.output_template_path,
          active: payloadBase.active,
          priority: payloadBase.priority,
          single_source_config: singleConfig,
          multi_source_step1_config: multiStep1Config,
          multi_source_step2_config: multiStep2Config,
          internal_join_key:
            form.item_type === 'multi_source'
              ? (form.multi_internal_join_key || '').trim() || null
              : editingConfig.internal_join_key || null,
          attachment_sources:
            form.item_type === 'multi_source' && attachmentSources.length > 0
              ? attachmentSources
              : editingConfig.attachment_sources,
        });
        setConfigs((prev) =>
          prev.map((cfg) => (cfg.config_id === updated.config_id ? updated : cfg)),
        );
      }
      resetForm();
    } catch (err) {
      console.error(err);
      setError(err instanceof Error ? err.message : 'Failed to save OCR config');
    } finally {
      setIsSubmitting(false);
    }
  };

  const openDeleteDialog = (cfg: CompanyDocTypeConfig) => {
    setDeleteDialog({
      isOpen: true,
      entity: {
        type: 'config',
        id: cfg.config_id,
        name: `${cfg.company_name || cfg.company_id} / ${cfg.doc_type_name || cfg.doc_type_id} / ${cfg.item_type}`,
      },
    });
  };

  const handleDeleteSuccess = () => {
    if (deleteDialog.entity) {
      setConfigs((prev) => prev.filter((c) => c.config_id !== deleteDialog.entity!.id));
    }
    setDeleteDialog({ isOpen: false, entity: null });
  };

  const handleDeleteCancel = () => {
    setDeleteDialog({ isOpen: false, entity: null });
  };

  const getCompanyName = (id: number) =>
    companyLookup.get(id)?.company_name || `ID ${id}`;
  const getDocTypeName = (id: number) =>
    docTypeLookup.get(id)?.type_name || `ID ${id}`;

  return (
    <div className="max-w-6xl mx-auto">
      <div className="flex items-center justify-between mb-6">
        <h1 className="text-2xl font-bold">Unified OCR Configs</h1>
        <button
          onClick={resetForm}
          className="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 text-sm"
        >
          {mode === 'create' ? 'New Config' : 'New Config'}
        </button>
      </div>

      <p className="mb-4 text-sm text-gray-600">
        These configs unify prompt/schema paths and mapping defaults per Company + Document
        Type + Item Type. Legacy &quot;Configurations&quot; and &quot;Mapping Templates&quot; remain
        as fallbacks.
      </p>

      {error && (
        <div className="mb-4 bg-red-100 text-red-800 px-4 py-2 rounded text-sm">
          {error}
        </div>
      )}

      {/* Filters */}
      <div className="mb-6 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label className="block text-xs font-semibold text-gray-600 mb-1">
            Company
          </label>
          <select
            className="w-full border border-gray-300 rounded px-2 py-1 text-sm"
            value={filters.company_id}
            onChange={(e) =>
              setFilters((prev) => ({ ...prev, company_id: e.target.value }))
            }
          >
            <option value="">All</option>
            {companies.map((c) => (
              <option key={c.company_id} value={c.company_id}>
                {c.company_name}
              </option>
            ))}
          </select>
        </div>
        <div>
          <label className="block text-xs font-semibold text-gray-600 mb-1">
            Document Type
          </label>
          <select
            className="w-full border border-gray-300 rounded px-2 py-1 text-sm"
            value={filters.doc_type_id}
            onChange={(e) =>
              setFilters((prev) => ({ ...prev, doc_type_id: e.target.value }))
            }
          >
            <option value="">All</option>
            {docTypes.map((d) => (
              <option key={d.doc_type_id} value={d.doc_type_id}>
                {d.type_name}
              </option>
            ))}
          </select>
        </div>
        <div>
          <label className="block text-xs font-semibold text-gray-600 mb-1">
            Status
          </label>
          <select
            className="w-full border border-gray-300 rounded px-2 py-1 text-sm"
            value={filters.active}
            onChange={(e) =>
              setFilters((prev) => ({ ...prev, active: e.target.value }))
            }
          >
            <option value="">All</option>
            <option value="true">Active</option>
            <option value="false">Inactive</option>
          </select>
        </div>
      </div>

      {/* Form */}
      <div className="mb-8 bg-white shadow rounded-lg p-4">
        <h2 className="text-lg font-semibold mb-4">
          {mode === 'create' ? 'Create OCR Config' : 'Edit OCR Config'}
        </h2>
        <form onSubmit={onSubmit} className="space-y-4">
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
          <label className="block text-xs font-semibold text-gray-600 mb-1">
            Company
          </label>
          <select
            name="company_id"
            value={form.company_id}
            onChange={onFormChange}
            className="w-full border border-gray-300 rounded px-2 py-1 text-sm"
            required
            disabled={mode === 'edit'}
          >
            <option value="">Select Company</option>
            {companies.map((c) => (
              <option key={c.company_id} value={c.company_id}>
                {c.company_name}
                  </option>
                ))}
              </select>
            </div>
            <div>
              <label className="block text-xs font-semibold text-gray-600 mb-1">
                Document Type
              </label>
              <select
                name="doc_type_id"
                value={form.doc_type_id}
                onChange={onFormChange}
                className="w-full border border-gray-300 rounded px-2 py-1 text-sm"
                required
                disabled={mode === 'edit'}
              >
                <option value="">Select Document Type</option>
                {docTypes.map((d) => (
                  <option key={d.doc_type_id} value={d.doc_type_id}>
                    {d.type_name}
                  </option>
                ))}
              </select>
            </div>
            <div>
              <label className="block text-xs font-semibold text-gray-600 mb-1">
                Item Type
              </label>
              <select
                name="item_type"
                value={form.item_type}
                onChange={onFormChange}
                className="w-full border border-gray-300 rounded px-2 py-1 text-sm"
                disabled={mode === 'edit'}
              >
                {ITEM_TYPE_OPTIONS.map((opt) => (
                  <option key={opt.value} value={opt.value}>
                    {opt.label}
                  </option>
                ))}
              </select>
            </div>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              {editingConfig ? (
                <ConfigFileUploadField
                  configId={editingConfig.config_id}
                  fileType="prompt"
                  currentPath={form.prompt_path}
                  originalFilename={form.original_prompt_filename}
                  onUploadComplete={handlePromptUploadComplete}
                />
              ) : (
                renderUploadPlaceholder('Prompt File')
              )}
            </div>
            <div>
              {editingConfig ? (
                <ConfigFileUploadField
                  configId={editingConfig.config_id}
                  fileType="schema"
                  currentPath={form.schema_path}
                  originalFilename={form.original_schema_filename}
                  onUploadComplete={handleSchemaUploadComplete}
                />
              ) : (
                renderUploadPlaceholder('Schema File')
              )}
            </div>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <MasterCsvPicker
                value={form.master_csv_path}
                onChange={handleMasterCsvChange}
                onPreview={form.master_csv_path.trim() ? handlePreviewMasterCsv : undefined}
                configId={editingConfig?.config_id}
              />
              <div className="mt-2 flex items-center gap-2 min-h-[1rem]">
                {isPreviewingCsv && (
                  <span className="text-xs text-gray-500">Loading preview…</span>
                )}
                {csvPreview && (
                  <span className="text-xs text-gray-600">
                    {csvPreview.headers.length} columns · {csvPreview.row_count} rows
                  </span>
                )}
              </div>
              {csvPreview && csvPreview.headers.length > 0 && (
                <div className="mt-2 bg-gray-50 border border-gray-200 rounded p-2">
                  <div className="text-[11px] text-gray-600 mb-1">
                    Columns (click to toggle in{' '}
                    {form.item_type === 'single_source' ? 'External Join Keys' : 'Step 2 Join Keys'}
                    ):
                  </div>
                  <div className="flex flex-wrap gap-1">
                    {csvPreview.headers.slice(0, 24).map((h, i) => {
                      const currentKeysStr =
                        form.item_type === 'single_source'
                          ? form.single_external_join_keys
                          : form.multi_step2_join_keys;
                      const setFromStr = (value: string) =>
                        setForm((prev) => ({
                          ...prev,
                          ...(form.item_type === 'single_source'
                            ? { single_external_join_keys: value }
                            : { multi_step2_join_keys: value }),
                        }));
                      const tokens = currentKeysStr
                        .split(',')
                        .map((k) => k.trim())
                        .filter(Boolean);
                      const selected = tokens.includes(h);
                      return (
                        <button
                          type="button"
                          key={i}
                          onClick={() => {
                            const set = new Set(tokens);
                            if (set.has(h)) {
                              set.delete(h);
                            } else {
                              set.add(h);
                            }
                            setFromStr(Array.from(set).join(', '));
                          }}
                          className={`text-[11px] border rounded px-2 py-0.5 ${
                            selected
                              ? 'bg-blue-600 text-white border-blue-700'
                              : 'bg-white text-gray-800 border-gray-300'
                          }`}
                          title={
                            selected
                              ? 'Remove from join keys'
                              : 'Add to join keys for master CSV'
                          }
                        >
                          {h}
                        </button>
                      );
                    })}
                    {csvPreview.headers.length > 24 && (
                      <span className="text-[11px] text-gray-500">
                        +{csvPreview.headers.length - 24} more
                      </span>
                    )}
                  </div>
                </div>
              )}
            </div>
            <div>
              {editingConfig ? (
                <ConfigFileUploadField
                  configId={editingConfig.config_id}
                  fileType="output_template"
                  currentPath={form.output_template_path}
                  onUploadComplete={handleOutputTemplateUploadComplete}
                />
              ) : (
                renderUploadPlaceholder('Output Template File')
              )}
            </div>
          </div>

          {/* Mapping sections */}
          {form.item_type === 'single_source' && (
            <div className="mt-4 border-t pt-4">
              <h3 className="text-sm font-semibold text-gray-800 mb-2">
                Single-Source Mapping Defaults
              </h3>
              <p className="text-xs text-gray-500 mb-3">
                Configure how OCR results join to the master CSV for this company + document
                type. These settings are applied automatically when creating order items.
              </p>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label className="block text-xs font-semibold text-gray-600 mb-1">
                    External Join Keys
                  </label>
                  <input
                    type="text"
                    value={form.single_external_join_keys}
                    onChange={(e) =>
                      setForm((prev) => ({
                        ...prev,
                        single_external_join_keys: e.target.value,
                      }))
                    }
                    className="w-full border border-gray-300 rounded px-2 py-1 text-sm"
                    placeholder="Comma separated, e.g. service_number, account_id"
                  />
                </div>
                <div>
                  <label className="block text-xs font-semibold text-gray-600 mb-1">
                    Column Aliases (optional)
                  </label>
                  <input
                    type="text"
                    value={form.single_column_aliases}
                    onChange={(e) =>
                      setForm((prev) => ({
                        ...prev,
                        single_column_aliases: e.target.value,
                      }))
                    }
                    className="w-full border border-gray-300 rounded px-2 py-1 text-sm"
                    placeholder="Format: ocr_field:csv_field, ..."
                  />
                </div>
              </div>
              <div className="mt-3 flex flex-wrap items-center gap-4 text-xs">
                <label className="inline-flex items-center gap-2">
                  <input
                    type="checkbox"
                    checked={form.single_normalize_strip_non_digits}
                    onChange={(e) =>
                      setForm((prev) => ({
                        ...prev,
                        single_normalize_strip_non_digits: e.target.checked,
                      }))
                    }
                  />
                  <span>Strip non-digits before joining</span>
                </label>
                <label className="inline-flex items-center gap-2">
                  <span>ZFill</span>
                  <input
                    type="number"
                    min={0}
                    value={form.single_normalize_zfill}
                    onChange={(e) =>
                      setForm((prev) => ({
                        ...prev,
                        single_normalize_zfill: e.target.value,
                      }))
                    }
                    className="w-24 border border-gray-300 rounded px-2 py-1"
                    placeholder="e.g. 8"
                  />
                </label>
                <label className="inline-flex items-center gap-2">
                  <span>Merge suffix</span>
                  <input
                    type="text"
                    value={form.single_merge_suffix}
                    onChange={(e) =>
                      setForm((prev) => ({
                        ...prev,
                        single_merge_suffix: e.target.value,
                      }))
                    }
                    className="w-24 border border-gray-300 rounded px-2 py-1"
                    placeholder="_master"
                  />
                </label>
              </div>
              <div className="mt-4 text-xs">
                <div className="font-semibold text-gray-700 mb-1">
                  Output Columns (optional)
                </div>
                {(form.single_output_meta_rows || []).map((row, idx) => (
                  <div key={idx} className="flex items-end gap-2 mb-2">
                    <div>
                      <label className="block text-[11px] text-gray-600 mb-1">
                        Dest Column
                      </label>
                      <input
                        type="text"
                        value={row.dest}
                        onChange={(e) => {
                          const next = [...form.single_output_meta_rows];
                          next[idx] = { ...row, dest: e.target.value };
                          setForm((prev) => ({
                            ...prev,
                            single_output_meta_rows: next,
                          }));
                        }}
                        className="w-36 border border-gray-300 rounded px-2 py-1"
                        placeholder="e.g. order_id"
                      />
                    </div>
                    <div>
                      <label className="block text-[11px] text-gray-600 mb-1">
                        Source
                      </label>
                      <select
                        value={row.srcType}
                        onChange={(e) => {
                          const next = [...form.single_output_meta_rows];
                          next[idx] = {
                            ...row,
                            srcType: e.target.value as 'ctx' | 'col',
                          };
                          setForm((prev) => ({
                            ...prev,
                            single_output_meta_rows: next,
                          }));
                        }}
                        className="w-24 border border-gray-300 rounded px-2 py-1"
                      >
                        <option value="ctx">Context</option>
                        <option value="col">Existing Column</option>
                      </select>
                    </div>
                    <div>
                      <label className="block text-[11px] text-gray-600 mb-1">
                        Key
                      </label>
                      <input
                        type="text"
                        value={row.srcKey}
                        onChange={(e) => {
                          const next = [...form.single_output_meta_rows];
                          next[idx] = { ...row, srcKey: e.target.value };
                          setForm((prev) => ({
                            ...prev,
                            single_output_meta_rows: next,
                          }));
                        }}
                        className="w-40 border border-gray-300 rounded px-2 py-1"
                        placeholder="e.g. order_id or __item_id"
                      />
                    </div>
                    <button
                      type="button"
                      onClick={() => {
                        const next = [...form.single_output_meta_rows];
                        next.splice(idx, 1);
                        setForm((prev) => ({
                          ...prev,
                          single_output_meta_rows: next,
                        }));
                      }}
                      className="px-3 py-1 text-xs bg-red-600 text-white rounded"
                    >
                      Remove
                    </button>
                  </div>
                ))}
                <button
                  type="button"
                  onClick={() =>
                    setForm((prev) => ({
                      ...prev,
                      single_output_meta_rows: [
                        ...(prev.single_output_meta_rows || []),
                        { dest: '', srcType: 'ctx', srcKey: '' },
                      ],
                    }))
                  }
                  className="mt-1 px-3 py-1 text-xs bg-gray-700 text-white rounded"
                >
                  + Add Output Column
                </button>
              </div>
            </div>
          )}

          {form.item_type === 'multi_source' && (
            <div className="mt-4 border-t pt-4 space-y-4">
              <div>
                <h3 className="text-sm font-semibold text-gray-800 mb-1">
                  Multi-Source Mapping Defaults
                </h3>
                <p className="text-xs text-gray-500">
                  Two-step join: (1) OCR + attachments → Month Excel (selected in order
                  item), then (2) step1 result → Master CSV. Configure join keys and
                  normalization for each step.
                </p>
              </div>

              {/* Step 1 */}
              <div className="border rounded-md p-3 bg-gray-50">
                <div className="text-xs font-semibold text-gray-700 mb-2">
                  Step 1: OCR → Month Excel
                </div>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                  <div>
                    <label className="block text-[11px] font-semibold text-gray-600 mb-1">
                      Join Keys
                    </label>
                    <input
                      type="text"
                      value={form.multi_step1_join_keys}
                      onChange={(e) =>
                        setForm((prev) => ({
                          ...prev,
                          multi_step1_join_keys: e.target.value,
                        }))
                      }
                      className="w-full border border-gray-300 rounded px-2 py-1 text-xs"
                      placeholder="Comma separated, e.g. service_number"
                    />
                  </div>
                  <div>
                    <label className="block text-[11px] font-semibold text-gray-600 mb-1">
                      Column Aliases (optional)
                    </label>
                    <input
                      type="text"
                      value={form.multi_step1_column_aliases}
                      onChange={(e) =>
                        setForm((prev) => ({
                          ...prev,
                          multi_step1_column_aliases: e.target.value,
                        }))
                      }
                      className="w-full border border-gray-300 rounded px-2 py-1 text-xs"
                      placeholder="Format: ocr_field:excel_field, ..."
                    />
                  </div>
                </div>
                <div className="mt-2 flex flex-wrap items-center gap-3 text-[11px]">
                  <label className="inline-flex items-center gap-1">
                    <input
                      type="checkbox"
                      checked={form.multi_step1_normalize_strip_non_digits}
                      onChange={(e) =>
                        setForm((prev) => ({
                          ...prev,
                          multi_step1_normalize_strip_non_digits: e.target.checked,
                        }))
                      }
                    />
                    <span>Strip non-digits</span>
                  </label>
                  <label className="inline-flex items-center gap-2">
                    <span>ZFill</span>
                    <input
                      type="number"
                      min={0}
                      value={form.multi_step1_normalize_zfill}
                      onChange={(e) =>
                        setForm((prev) => ({
                          ...prev,
                          multi_step1_normalize_zfill: e.target.value,
                        }))
                      }
                      className="w-20 border border-gray-300 rounded px-2 py-1"
                      placeholder="e.g. 8"
                    />
                  </label>
                  <label className="inline-flex items-center gap-2">
                    <span>Merge suffix</span>
                    <input
                      type="text"
                      value={form.multi_step1_merge_suffix}
                      onChange={(e) =>
                        setForm((prev) => ({
                          ...prev,
                          multi_step1_merge_suffix: e.target.value,
                        }))
                      }
                      className="w-20 border border-gray-300 rounded px-2 py-1"
                      placeholder="_month"
                    />
                  </label>
                </div>
              </div>

              {/* Step 2 */}
              <div className="border rounded-md p-3 bg-gray-50">
                <div className="text-xs font-semibold text-gray-700 mb-2">
                  Step 2: Step1 Result → Master CSV
                </div>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                  <div>
                    <label className="block text-[11px] font-semibold text-gray-600 mb-1">
                      Join Keys
                    </label>
                    <input
                      type="text"
                      value={form.multi_step2_join_keys}
                      onChange={(e) =>
                        setForm((prev) => ({
                          ...prev,
                          multi_step2_join_keys: e.target.value,
                        }))
                      }
                      className="w-full border border-gray-300 rounded px-2 py-1 text-xs"
                      placeholder="Comma separated, e.g. account_id"
                    />
                  </div>
                  <div>
                    <label className="block text-[11px] font-semibold text-gray-600 mb-1">
                      Column Aliases (optional)
                    </label>
                    <input
                      type="text"
                      value={form.multi_step2_column_aliases}
                      onChange={(e) =>
                        setForm((prev) => ({
                          ...prev,
                          multi_step2_column_aliases: e.target.value,
                        }))
                      }
                      className="w-full border border-gray-300 rounded px-2 py-1 text-xs"
                      placeholder="Format: step1_field:master_field, ..."
                    />
                  </div>
                </div>
                <div className="mt-2 flex flex-wrap items-center gap-3 text-[11px]">
                  <label className="inline-flex items-center gap-1">
                    <input
                      type="checkbox"
                      checked={form.multi_step2_normalize_strip_non_digits}
                      onChange={(e) =>
                        setForm((prev) => ({
                          ...prev,
                          multi_step2_normalize_strip_non_digits: e.target.checked,
                        }))
                      }
                    />
                    <span>Strip non-digits</span>
                  </label>
                  <label className="inline-flex items-center gap-2">
                    <span>ZFill</span>
                    <input
                      type="number"
                      min={0}
                      value={form.multi_step2_normalize_zfill}
                      onChange={(e) =>
                        setForm((prev) => ({
                          ...prev,
                          multi_step2_normalize_zfill: e.target.value,
                        }))
                      }
                      className="w-20 border border-gray-300 rounded px-2 py-1"
                      placeholder="e.g. 8"
                    />
                  </label>
                  <label className="inline-flex items-center gap-2">
                    <span>Merge suffix</span>
                    <input
                      type="text"
                      value={form.multi_step2_merge_suffix}
                      onChange={(e) =>
                        setForm((prev) => ({
                          ...prev,
                          multi_step2_merge_suffix: e.target.value,
                        }))
                      }
                      className="w-20 border border-gray-300 rounded px-2 py-1"
                      placeholder="_master"
                    />
                  </label>
                </div>
                <div className="mt-3 text-xs">
                  <div className="font-semibold text-gray-700 mb-1">
                    Output Columns (optional)
                  </div>
                  {(form.multi_step2_output_meta_rows || []).map((row, idx) => (
                    <div key={idx} className="flex items-end gap-2 mb-2">
                      <div>
                        <label className="block text-[11px] text-gray-600 mb-1">
                          Dest Column
                        </label>
                        <input
                          type="text"
                          value={row.dest}
                          onChange={(e) => {
                            const next = [...form.multi_step2_output_meta_rows];
                            next[idx] = { ...row, dest: e.target.value };
                            setForm((prev) => ({
                              ...prev,
                              multi_step2_output_meta_rows: next,
                            }));
                          }}
                          className="w-36 border border-gray-300 rounded px-2 py-1"
                          placeholder="e.g. order_id"
                        />
                      </div>
                      <div>
                        <label className="block text-[11px] text-gray-600 mb-1">
                          Source
                        </label>
                        <select
                          value={row.srcType}
                          onChange={(e) => {
                            const next = [...form.multi_step2_output_meta_rows];
                            next[idx] = {
                              ...row,
                              srcType: e.target.value as 'ctx' | 'col',
                            };
                            setForm((prev) => ({
                              ...prev,
                              multi_step2_output_meta_rows: next,
                            }));
                          }}
                          className="w-24 border border-gray-300 rounded px-2 py-1"
                        >
                          <option value="ctx">Context</option>
                          <option value="col">Existing Column</option>
                        </select>
                      </div>
                      <div>
                        <label className="block text-[11px] text-gray-600 mb-1">
                          Key
                        </label>
                        <input
                          type="text"
                          value={row.srcKey}
                          onChange={(e) => {
                            const next = [...form.multi_step2_output_meta_rows];
                            next[idx] = { ...row, srcKey: e.target.value };
                            setForm((prev) => ({
                              ...prev,
                              multi_step2_output_meta_rows: next,
                            }));
                          }}
                          className="w-40 border border-gray-300 rounded px-2 py-1"
                          placeholder="e.g. order_id or __item_id"
                        />
                      </div>
                      <button
                        type="button"
                        onClick={() => {
                          const next = [...form.multi_step2_output_meta_rows];
                          next.splice(idx, 1);
                          setForm((prev) => ({
                            ...prev,
                            multi_step2_output_meta_rows: next,
                          }));
                        }}
                        className="px-3 py-1 text-xs bg-red-600 text-white rounded"
                      >
                        Remove
                      </button>
                    </div>
                  ))}
                  <button
                    type="button"
                    onClick={() =>
                      setForm((prev) => ({
                        ...prev,
                        multi_step2_output_meta_rows: [
                          ...(prev.multi_step2_output_meta_rows || []),
                          { dest: '', srcType: 'ctx', srcKey: '' },
                        ],
                      }))
                    }
                    className="mt-1 px-3 py-1 text-xs bg-gray-700 text-white rounded"
                  >
                    + Add Output Column
                  </button>
                </div>
              </div>

              {/* Internal join key & attachments */}
              <div className="border rounded-md p-3 bg-white">
                <div className="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
                  <div>
                    <label className="block text-[11px] font-semibold text-gray-600 mb-1">
                      Internal Join Key (primary ↔ attachments)
                    </label>
                    <input
                      type="text"
                      value={form.multi_internal_join_key}
                      onChange={(e) =>
                        setForm((prev) => ({
                          ...prev,
                          multi_internal_join_key: e.target.value,
                        }))
                      }
                      className="w-full border border-gray-300 rounded px-2 py-1 text-xs"
                      placeholder="e.g. service_number"
                    />
                    <p className="mt-1 text-[11px] text-gray-500">
                      Used as the default join key when attachment rules do not provide their own
                      join_key.
                    </p>
                  </div>
                </div>
                <div className="mt-2 text-xs">
                  <div className="font-semibold text-gray-700 mb-1">
                    Attachment Sources (optional)
                  </div>
                  <p className="text-[11px] text-gray-500 mb-2">
                    Define OneDrive folders for PDF attachments (e.g. per month). Each rule may
                    specify a join_key or rely on the global internal_join_key.
                  </p>
                  {multiAttachmentRules.map((rule, idx) => (
                    <div key={idx} className="mb-2 border rounded p-2 space-y-1 bg-gray-50">
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                        <div>
                          <label className="block text-[11px] text-gray-600 mb-1">
                            OneDrive Path
                          </label>
                          <div className="flex gap-2">
                            <input
                              type="text"
                              value={rule.path || ''}
                              onChange={(e) => {
                                const next = [...multiAttachmentRules];
                                next[idx] = { ...rule, path: e.target.value };
                                setMultiAttachmentRules(next);
                              }}
                              className="flex-1 border border-gray-300 rounded px-2 py-1 text-xs"
                              placeholder="e.g. HYA-OCR/Attachments/202501"
                            />
                            <button
                              type="button"
                              onClick={() => openAttachmentBrowser(idx)}
                              className="px-3 py-1 text-[11px] font-medium text-gray-700 border border-gray-300 rounded hover:bg-gray-100"
                            >
                              Browse
                            </button>
                          </div>
                        </div>
                        <div>
                          <label className="block text-[11px] text-gray-600 mb-1">
                            Join Key (optional)
                          </label>
                          <input
                            type="text"
                            value={rule.join_key || ''}
                            onChange={(e) => {
                              const next = [...multiAttachmentRules];
                              next[idx] = { ...rule, join_key: e.target.value };
                              setMultiAttachmentRules(next);
                            }}
                            className="w-full border border-gray-300 rounded px-2 py-1 text-xs"
                            placeholder="Overrides internal join key"
                          />
                        </div>
                      </div>
                      <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                        <div>
                          <label className="block text-[11px] text-gray-600 mb-1">
                            Filename Contains (optional)
                          </label>
                          <input
                            type="text"
                            value={rule.filename_contains || ''}
                            onChange={(e) => {
                              const next = [...multiAttachmentRules];
                              next[idx] = { ...rule, filename_contains: e.target.value };
                              setMultiAttachmentRules(next);
                            }}
                            className="w-full border border-gray-300 rounded px-2 py-1 text-xs"
                            placeholder="Substring used to match attachments"
                          />
                        </div>
                        <div>
                          <label className="block text-[11px] text-gray-600 mb-1">
                            Label (optional)
                          </label>
                          <input
                            type="text"
                            value={rule.label || ''}
                            onChange={(e) => {
                              const next = [...multiAttachmentRules];
                              next[idx] = { ...rule, label: e.target.value };
                              setMultiAttachmentRules(next);
                            }}
                            className="w-full border border-gray-300 rounded px-2 py-1 text-xs"
                            placeholder="Shown in UI, e.g. '2025-01 Attachments'"
                          />
                        </div>
                      </div>
                      <div>
                        <label className="block text-[11px] text-gray-600 mb-1">
                          Metadata JSON (optional)
                        </label>
                        <textarea
                          value={rule.metadata || ''}
                          onChange={(e) => {
                            const next = [...multiAttachmentRules];
                            next[idx] = { ...rule, metadata: e.target.value };
                            setMultiAttachmentRules(next);
                          }}
                          className="w-full border border-gray-300 rounded px-2 py-1 text-[11px]"
                          rows={2}
                          placeholder='e.g. {"month":"202501"}'
                        />
                      </div>
                      <div className="flex justify-end">
                        <button
                          type="button"
                          onClick={() => {
                            const next = [...multiAttachmentRules];
                            next.splice(idx, 1);
                            setMultiAttachmentRules(next);
                          }}
                          className="px-3 py-1 text-xs bg-red-600 text-white rounded"
                        >
                          Remove Rule
                        </button>
                      </div>
                    </div>
                  ))}
                  <button
                    type="button"
                    onClick={() =>
                      setMultiAttachmentRules((prev) => [
                        ...prev,
                        {
                          path: '',
                          filename_contains: '',
                          join_key: '',
                          label: '',
                          metadata: '',
                        },
                      ])
                    }
                    className="px-3 py-1 text-xs bg-gray-700 text-white rounded"
                  >
                    + Add Attachment Rule
                  </button>
                </div>
              </div>
            </div>
          )}

          <div className="flex items-center gap-4">
            <div>
              <label className="block text-xs font-semibold text-gray-600 mb-1">
                Priority
              </label>
              <input
                type="number"
                name="priority"
                value={form.priority}
                onChange={onFormChange}
                className="w-28 border border-gray-300 rounded px-2 py-1 text-sm"
              />
            </div>
            <div className="flex items-center gap-2 mt-5">
              <input
                id="ocr-config-active"
                type="checkbox"
                name="active"
                checked={form.active}
                onChange={onFormChange}
                className="h-4 w-4"
              />
              <label
                htmlFor="ocr-config-active"
                className="text-sm text-gray-700"
              >
                Active
              </label>
            </div>
          </div>

          <div className="flex gap-3">
            <button
              type="submit"
              disabled={isSubmitting}
              className="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 text-sm disabled:bg-gray-400"
            >
              {isSubmitting
                ? 'Saving...'
                : mode === 'create'
                ? 'Create Config'
                : 'Update Config'}
            </button>
            {mode === 'edit' && (
              <button
                type="button"
                onClick={resetForm}
                className="px-4 py-2 text-sm rounded border border-gray-300 text-gray-700 hover:bg-gray-100"
              >
                Cancel Edit
              </button>
            )}
          </div>
        </form>
      </div>

      {/* List */}
      {isLoading ? (
        <div className="text-center py-10">Loading OCR configs...</div>
      ) : filteredConfigs.length === 0 ? (
        <div className="text-center py-10 text-gray-500">
          No OCR configs found. Click &quot;New Config&quot; to create one.
        </div>
      ) : (
        <div className="space-y-4">
          {groupedConfigs.map((company) => (
            <div
              key={company.company_id}
              className="border rounded-lg p-4 bg-white shadow"
            >
              <div className="flex items-center justify-between flex-wrap gap-2 mb-3">
                <div>
                  <div className="text-xs font-semibold text-gray-500 uppercase tracking-wide">
                    Company
                  </div>
                  <div className="text-lg font-bold text-gray-900">
                    {company.company_name}
                  </div>
                </div>
                <div className="text-xs text-gray-500">
                  {company.doc_types.reduce(
                    (acc, dt) => acc + dt.configs.length,
                    0,
                  )}{' '}
                  config
                  {company.doc_types.reduce(
                    (acc, dt) => acc + dt.configs.length,
                    0,
                  ) !== 1 && 's'}
                </div>
              </div>

              <div className="space-y-3">
                {company.doc_types.map((docType) => (
                  <div
                    key={docType.doc_type_id}
                    className="ml-4 border-l-2 border-blue-200 pl-4"
                  >
                    <div className="flex items-center justify-between flex-wrap gap-2 mb-2">
                      <div className="text-sm font-semibold text-gray-800">
                        {docType.doc_type_name}
                      </div>
                    </div>

                    <div className="space-y-2">
                      {docType.configs.map((cfg) => (
                        <div
                          key={cfg.config_id}
                          className="bg-gray-50 rounded p-3 border flex flex-col md:flex-row md:items-start md:justify-between gap-3"
                        >
                          <div className="flex-1 space-y-2">
                            <div className="flex items-center gap-2 flex-wrap">
                              <span className="px-2 py-0.5 rounded-full text-xs font-semibold bg-gray-200 text-gray-800">
                                #{cfg.config_id}
                              </span>
                              <span
                                className={`px-2 py-0.5 rounded-full text-xs font-semibold ${
                                  cfg.item_type === 'multi_source'
                                    ? 'bg-purple-100 text-purple-800'
                                    : 'bg-blue-100 text-blue-800'
                                }`}
                              >
                                {cfg.item_type === 'multi_source'
                                  ? 'Multi Source'
                                  : 'Single Source'}
                              </span>
                              <span
                                className={`px-2 py-0.5 rounded-full text-xs font-semibold ${
                                  cfg.active
                                    ? 'bg-green-100 text-green-800'
                                    : 'bg-red-100 text-red-800'
                                }`}
                              >
                                {cfg.active ? 'Active' : 'Inactive'}
                              </span>
                            </div>

                            <div className="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs text-gray-700">
                              <div>
                                <div className="font-semibold text-gray-600 mb-0.5">
                                  Master CSV
                                </div>
                                <div
                                  className="truncate text-gray-800"
                                  title={cfg.master_csv_path || ''}
                                >
                                  {cfg.master_csv_path || '—'}
                                </div>
                              </div>
                              <div>
                                <div className="font-semibold text-gray-600 mb-0.5">
                                  Prompt
                                </div>
                                <div
                                  className="truncate text-gray-800"
                                  title={cfg.prompt_path || ''}
                                >
                                  {cfg.prompt_path || '—'}
                                </div>
                              </div>
                              <div>
                                <div className="font-semibold text-gray-600 mb-0.5">
                                  Schema
                                </div>
                                <div
                                  className="truncate text-gray-800"
                                  title={cfg.schema_path || ''}
                                >
                                  {cfg.schema_path || '—'}
                                </div>
                              </div>
                            </div>
                          </div>
                          <div className="flex items-center gap-3 justify-end md:justify-end">
                            <button
                              onClick={() => onEdit(cfg)}
                              className="text-indigo-600 hover:text-indigo-900 text-xs"
                            >
                              Edit
                            </button>
                            <button
                              onClick={() => openDeleteDialog(cfg)}
                              className="text-red-600 hover:text-red-900 text-xs"
                            >
                              Delete
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      )}

      <OneDriveBrowserModal
        open={attachmentModalIndex !== null}
        onClose={closeAttachmentBrowser}
        onSelect={handleAttachmentPathSelect}
        initialPath={
          attachmentModalIndex !== null
            ? multiAttachmentRules[attachmentModalIndex]?.path || ''
            : ''
        }
        filterExt=".pdf,.xlsx,.csv"
        configId={editingConfig?.config_id}
      />

      <SmartDeleteDialog
        isOpen={deleteDialog.isOpen}
        onClose={handleDeleteCancel}
        onSuccess={handleDeleteSuccess}
        entity={deleteDialog.entity!}
      />
    </div>
  );
}
