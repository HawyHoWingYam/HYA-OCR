# 基础应用配置
API_BASE_URL=http://localhost:8000
PORT=8000
ENVIRONMENT=local
MODEL_NAME=gemini-2.5-flash

# Gemini 模型分層（可選，逗號分隔，從左到右依次為 tier1、tier2、...）
# 例如：免費額度用 gemini-2.5-flash，用完後自動切到付費 gemini-2.5-pro
#GEMINI_MODEL_TIERS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite

# 本地资料总目录（相对 backend/）
LOCAL_STORAGE_ROOT=../storage
PROMPT_LOCAL_PATH=../storage/prompts
SCHEMA_LOCAL_PATH=../storage/schemas
LOCAL_UPLOAD_DIR=../storage/upload
LOCAL_ORDERS_DIR=../storage/upload/orders
LOCAL_UPLOAD_IMAGE_DIR=../storage/upload/images
LOCAL_UPLOAD_PDF_DIR=../storage/upload/pdfs
LOCAL_RESULTS_DIR=../storage/results
LOCAL_RESULT_JSON_DIR=../storage/results/json
LOCAL_RESULT_CSV_DIR=../storage/results/csv

# 数据库连接（PostgreSQL / AWS RDS）
# 注意：密码中的特殊字符已进行 URL 编码
DATABASE_URL=postgresql://postgres:admin@127.0.0.1:5432/document_processing_platform

# Gemini API Key（至少保留一把）- 請在本地填入真實值，避免提交到版本庫
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 存储后端：强制使用本地文件系统
STORAGE_BACKEND=local
#S3_BUCKET_NAME=your-s3-bucket-name
#AWS_DEFAULT_REGION=ap-southeast-1
#AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
#AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE

# Prompt/Schema 管理强制走本地备份目录
PROMPT_SCHEMA_STORAGE_BACKEND=local
PROMPT_SCHEMA_LOCAL_BACKUP_PATH=../storage

# OneDrive 同步（默认关闭；如需启用请设置 ONEDRIVE_SYNC_ENABLED=true）
ONEDRIVE_SYNC_ENABLED=false
#ONEDRIVE_CLIENT_ID=YOUR_ONEDRIVE_CLIENT_ID_HERE
#ONEDRIVE_CLIENT_SECRET=YOUR_ONEDRIVE_CLIENT_SECRET_HERE
#ONEDRIVE_TENANT_ID=YOUR_ONEDRIVE_TENANT_ID_HERE
#ONEDRIVE_TARGET_USER_UPN=your_onedrive_user@company.com

# 提示/Schema 管理（可选）
#PROMPT_SCHEMA_CACHE_ENABLED=false
#PROMPT_SCHEMA_CACHE_SIZE=200
#PROMPT_SCHEMA_LOCAL_BACKUP_PATH=/app/prompt-schema-backup
